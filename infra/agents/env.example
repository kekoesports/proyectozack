# Worker de agentes — plantilla de variables. Copiar a `.env` y rellenar.
#
# Este fichero se commitea; el `.env` resultante NO. Aquí no va ningún valor
# real. (Se llama `env.example` y no `.env.example` porque el repositorio tiene
# un hook que bloquea la edición de cualquier fichero `.env*`, plantillas
# incluidas.)

# ── Kill switch ──────────────────────────────────────────────────────────────
# Solo la cadena exacta 'true' enciende el worker. Cualquier otra cosa —vacío,
# 'True', '1'— lo deja arrancado sin procesar nada.
AGENTS_ENABLED=false

# Identificador de este worker. Aparece en `agent_worker_heartbeats` y en
# `agent_runs.lease_owner`. Con varios workers, uno distinto por contenedor.
AGENT_WORKER_ID=worker-1

# ── Base de datos ────────────────────────────────────────────────────────────
# La misma base que la aplicación: la cola vive ahí. Rol de aplicación, sin DDL.
DATABASE_URL=

# ── Modelo ───────────────────────────────────────────────────────────────────
# Sin clave, el runtime usa NullProvider: arranca y falla en cerrado al generar.
# Los seis agentes se siembran con modelProvider='null', así que hasta que
# alguien lo cambie a mano ninguno sale a un modelo real aunque haya clave.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Límites operativos ───────────────────────────────────────────────────────
# 1 USD = 1.000.000 micros. 10.000.000 = 10 USD al mes en total.
AGENT_GLOBAL_MONTHLY_BUDGET_MICROS=10000000
AGENT_WORKER_POLL_MS=2000
AGENT_LEASE_SECONDS=60
AGENT_MAX_CONCURRENCY=1

# ── Endpoints internos (PR 5) ────────────────────────────────────────────────
# Todavía sin usar. Distintos de AUTOMATION_API_TOKEN a propósito: n8n y el
# worker no comparten superficie ni rotación.
# Generar con: openssl rand -hex 32
AGENT_INTERNAL_TOKEN=
AGENT_EVENT_HMAC_SECRET=

# ── Variables que el worker NO necesita ──────────────────────────────────────
# No copiar aquí BETTER_AUTH_SECRET, RESEND_API_KEY, BLOB_READ_WRITE_TOKEN ni
# ninguna clave de las integraciones. El worker no autentica usuarios, no envía
# emails y no sube ficheros. Cada secreto de más es superficie de más.
