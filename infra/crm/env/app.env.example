# Variables de la aplicación. Copiar a app.env y rellenar.
# app.env NO va a git y debe ser root-only (chmod 600).
#
# Las NEXT_PUBLIC_* NO sirven aquí: se incrustan en el bundle durante el build,
# así que van como --build-arg al construir la imagen. Ponerlas en este fichero
# no tiene ningún efecto.

# ── base de datos ───────────────────────────────────────────────────────────
# Rol de aplicación: sin permisos de DDL.
DATABASE_URL=postgresql://socialpro_app:CAMBIAR@postgres:5432/socialpro
# Rol migrador: solo lo usa `npm run migrate:deploy`, nunca la app.
MIGRATION_DATABASE_URL=postgresql://socialpro_migrator:CAMBIAR@postgres:5432/socialpro

DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000

# ── almacenamiento ──────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/srv/storage
STORAGE_PUBLIC_URL_BASE=https://socialpro.es/files
# Mientras dure el periodo de vuelta atrás, las lecturas caen a Vercel Blob si
# el fichero aún no se ha copiado. Se pone en false cuando la copia termine.
STORAGE_FALLBACK_TO_VERCEL=true
BLOB_READ_WRITE_TOKEN=

# ── identidad: NO regenerar durante el cutover ──────────────────────────────
# Cambiar BETTER_AUTH_SECRET invalida todas las sesiones abiertas.
# TOKEN_ENCRYPTION_KEY descifra datos ya guardados: si cambia, se pierden.
BETTER_AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
NEXT_PUBLIC_SITE_URL=https://socialpro.es

# ── integraciones (se mantienen tal cual) ───────────────────────────────────
RESEND_API_KEY=
CRON_SECRET=
AUTOMATION_API_TOKEN=
GEMINI_API_KEY=
GOOGLE_SHEETS_API_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_DEAL_TEMPLATE_ID=
GOOGLE_DRIVE_TRACKING_FOLDER_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
STEAM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
