	"rights_accepted_at" timestamp with time zone DEFAULT now() NOT NULL,
	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
	CONSTRAINT "studio_clip_source_kind_ck" CHECK ("studio_clip_sources"."kind" in ('twitch','kick','cs2')),
	CONSTRAINT "studio_clip_source_revision_ck" CHECK ("studio_clip_sources"."revision" >= 0)
);
