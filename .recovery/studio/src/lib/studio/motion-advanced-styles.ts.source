export function advancedMotionStyles(width: number, height: number, dark: boolean) {
  const portrait = height > width;
  return `
*{box-sizing:border-box}html,body{margin:0;width:${width}px;height:${height}px;overflow:hidden;background:${dark ? '#101016' : '#f4f1eb'};color:${dark ? '#faf8f4' : '#191820'};font-family:Body,sans-serif}
#socialpro-motion{position:relative;width:100%;height:100%;overflow:hidden;perspective:1200px;--card:${dark ? '#20212b' : '#fffaf4'};--line:${dark ? '#ffffff25' : '#19182025'};--accent:${dark ? '#ffad88' : '#9d2a52'}}
.rail{position:absolute;top:7%;left:8.5%;right:8.5%;display:flex;align-items:center;justify-content:space-between;gap:20px;z-index:3}.rail span{font-size:12px;font-weight:700;letter-spacing:2px}
.content{--fit:1;position:absolute;left:8.5%;right:8.5%;top:${portrait ? '25%' : '26%'};height:${portrait ? '55%' : '57%'};display:flex;flex-direction:column;justify-content:center;gap:calc(24px * var(--fit));z-index:2;perspective:1200px}.content>*{flex-shrink:0;min-width:0}
.eyebrow{font-size:12px;font-weight:700;letter-spacing:2px;color:var(--accent)}h1{margin:0;font-family:Display,sans-serif;font-weight:800;font-size:calc(${portrait ? 92 : 72}px * var(--fit));line-height:.98;text-transform:uppercase;letter-spacing:-.8px;overflow-wrap:anywhere}.word-mask{display:inline-block;vertical-align:top;overflow:hidden;max-width:100%;padding:0 .025em .09em;margin-bottom:-.09em;perspective:700px}.word{display:inline-block;transform-origin:50% 100%;max-width:100%;overflow-wrap:anywhere;will-change:transform,filter}
.description,.contact span,.item span,.table-cell{font-size:max(20px,calc(27px * var(--fit)));line-height:1.36;white-space:pre-wrap;overflow-wrap:anywhere;min-width:0}.description{max-width:910px}
.items{display:grid;gap:calc(12px * var(--fit));position:relative;perspective:1000px}.item{position:relative;display:flex;gap:calc(22px * var(--fit));align-items:center;padding:calc(18px * var(--fit)) 22px;border:1px solid var(--line);border-radius:12px;background:var(--card);transform-origin:50% 90%;box-shadow:0 12px 28px #0000000a;min-width:0;overflow:hidden}.marker{font-family:Display;font-size:32px;color:var(--accent);flex:none;line-height:1;position:relative;z-index:1}.item span{position:relative;z-index:1}.item:before,.table-row:before{content:'';position:absolute;inset:0;background:linear-gradient(110deg,#f5632a22,#e0307012);opacity:var(--focus,0);pointer-events:none}.item:after{content:'';position:absolute;left:0;bottom:0;width:100%;height:3px;background:linear-gradient(90deg,#f5632a,#e03070,#8b3aad);transform:scaleX(var(--trace,0));transform-origin:left}
.steps .item:nth-child(2){margin-left:16px}.steps .item:nth-child(3){margin-left:32px}.compare{grid-template-columns:1fr 1fr;gap:18px}.compare .item{min-height:calc(178px * var(--fit));flex-direction:column;align-items:flex-start;justify-content:space-between}.compare .item:last-child{border-color:#d86c55}.checklist .marker{width:34px;height:34px}.checklist svg{width:34px;height:34px}.checklist path{fill:none;stroke:var(--accent);stroke-width:3;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:42}.quiz .item{border-radius:50px}.quiz .marker{border-right:1px solid var(--line);padding-right:20px}
.timeline .item{margin-left:18px;border-left:3px solid #e03070}.connector{position:absolute;left:0;top:0;bottom:0;width:3px;transform-origin:top;background:linear-gradient(#f5632a,#e03070,#8b3aad)}.live{border:1px solid var(--line);padding:16px;border-radius:18px;background:var(--card)}.live .item{padding:calc(10px * var(--fit)) 14px;background:transparent;border:0;box-shadow:none}.waves{display:flex;height:32px;gap:6px;align-items:center;margin:0 14px 10px}.waves i{width:5px;height:30px;border-radius:4px;background:#e03070;transform-origin:center}
.contact{position:relative;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:calc(26px * var(--fit)) 28px;border-radius:12px;border:1px solid var(--line);background:var(--card);overflow:hidden;box-shadow:0 16px 50px #00000012}.contact:before{content:'';position:absolute;inset:0;background:linear-gradient(100deg,transparent 25%,#e030701c 50%,transparent 75%);transform:translateX(var(--shine,-100%));pointer-events:none}.contact b{font-size:42px;line-height:1;color:var(--accent)}
.data-table{border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--card);perspective:1100px}.table-head,.table-row{display:grid;grid-template-columns:34% 66%;position:relative;min-width:0}.table-head{font-size:11px;font-weight:700;letter-spacing:1.7px;background:${dark ? '#2c2d38' : '#e9e4dc'}}.table-head span{padding:14px 18px}.table-row{border-top:1px solid var(--line);transform-origin:left center}.table-cell{padding:calc(20px * var(--fit)) 18px;position:relative;z-index:1}.table-cell:first-child{font-size:max(20px,calc(24px * var(--fit)));font-weight:650;border-right:1px solid var(--line)}
.depth{position:absolute;inset:0;perspective:1100px;pointer-events:none;z-index:0}.depth i{position:absolute;display:block;width:80%;height:45%;left:35%;top:24%;border:1px solid var(--line);border-radius:24px;transform-style:preserve-3d}.depth i:nth-child(2){left:-20%;top:50%;width:72%;height:36%;border-color:#e0307024}.depth i:nth-child(3){left:52%;top:8%;height:75%;width:45%;border-color:#f5632a28}.design-metric .depth i{border-radius:50%;width:600px;height:600px;border-width:2px}.design-cinema .depth i{border-radius:4px;border-width:2px;background:linear-gradient(135deg,#e0307006,#f5632a0d)}.design-quote .depth:after{content:'“';position:absolute;top:12%;right:9%;font-family:Display;font-size:340px;color:#e0307020}.design-quote .content{border-left:4px solid #e03070;padding-left:24px}.design-metric h1{color:var(--accent)}
.signature{height:4px;width:140px;background:linear-gradient(90deg,#f5632a,#e03070,#8b3aad,#5b9bd5);transform-origin:left}.curtain{position:absolute;inset:-8%;z-index:8;pointer-events:none;overflow:hidden;visibility:hidden}.curtain i{position:absolute;inset:0;background:#e03070;transform:translateX(-125%) skewX(-9deg);will-change:transform}.curtain i:nth-child(2){background:#8b3aad}.curtain i:nth-child(3){background:${dark ? '#101016' : '#f4f1eb'}}
.rule{position:absolute;left:8.5%;right:8.5%;bottom:13%;height:1px;background:currentColor;opacity:.15;z-index:1}footer{position:absolute;left:8.5%;right:8.5%;bottom:9%;display:flex;justify-content:space-between;gap:18px;font-size:12px;font-weight:700;letter-spacing:1.5px;z-index:1}footer span{opacity:.55;font-size:10px}
`;
}
