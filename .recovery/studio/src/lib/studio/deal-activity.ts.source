import { campaigns } from '@/db/schema/campaigns';

type Deal = Pick<typeof campaigns.$inferSelect, 'status' | 'startDate' | 'endDate' | 'createdAt' | 'archivedAt'>;
export const STUDIO_DEAL_STATUSES = ['aprobada', 'activa', 'completada', 'pendiente_pago', 'pagada'] as const;

export function studioDealWindow(now = new Date()) {
  const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(now);
  const value = (type: Intl.DateTimeFormatPartTypes) => Number(parts.find(p => p.type === type)?.value);
  const year = value('year'), month = value('month') - 1, day = value('day');
  const start = new Date(Date.UTC(year, month - 4, 1));
  const last = new Date(Date.UTC(start.getUTCFullYear(), start.getUTCMonth() + 1, 0)).getUTCDate();
  start.setUTCDate(Math.min(day, last));
  return { since: start.toISOString().slice(0, 10), today: new Date(Date.UTC(year, month, day)).toISOString().slice(0, 10) };
}

export function studioDealActivity(deal: Deal, window: ReturnType<typeof studioDealWindow>) {
  if (!STUDIO_DEAL_STATUSES.some(s => s === deal.status)) return null;
  const current = !deal.archivedAt && (deal.status === 'activa' || deal.status === 'aprobada');
  const start = deal.startDate ?? deal.createdAt.toISOString().slice(0, 10);
  const end = deal.endDate ?? start;
  const recent = start <= window.today && end >= window.since;
  if (!current && !recent) return null;
  return { current, lastActivity: end > window.today ? window.today : end };
}
