/** Pure time-based choreography: no random values, timers or network in render mode. */
export function advancedMotionTimeline(duration: number, preview: boolean) {
  return `
const duration=${duration};let time=0,paused=true;
const clamp=v=>Math.max(0,Math.min(1,v)),smooth=v=>{v=clamp(v);return v*v*(3-2*v)},out=v=>1-Math.pow(1-clamp(v),4);
const box=document.querySelector('.content'),words=[...document.querySelectorAll('.word')],rows=[...document.querySelectorAll('.item,.table-row')],depth=[...document.querySelectorAll('.depth i')],panels=[...document.querySelectorAll('.curtain i')];
const tempo=Math.min(1,(duration-.5)/2.8);
function fit(){let scale=1;const measure=()=>Math.max(box.scrollHeight,[...box.children].reduce((n,e)=>n+e.offsetHeight,0)+(box.children.length-1)*parseFloat(getComputedStyle(box).gap));while(measure()>box.clientHeight+1&&scale>.56){scale-=.015;box.style.setProperty('--fit',scale);}window.__studioLayoutFits=measure()<=box.clientHeight+1;}
function seek(t){time=Math.max(0,Math.min(duration,Number(t)||0));const local=time/tempo;
 const camera=out(local/1.5),settle=smooth(local/1.8);box.style.transform='translateY('+((1-camera)*16)+'px)';
 words.forEach((word,i)=>{const p=out((local-.13-i*Math.min(.065,.5/Math.max(1,words.length)))/.75);word.style.opacity=clamp(p*3);word.style.filter='blur('+((1-p)*7)+'px)';word.style.transform='translate3d('+((1-p)*8)+'px,'+((1-p)*115)+'%,0) rotateX('+((1-p)*-65)+'deg)';});
 const eyebrow=document.querySelector('.eyebrow');eyebrow.style.opacity=out(local/.45);eyebrow.style.letterSpacing=(2+(1-out(local/.8))*4)+'px';
 const description=document.querySelector('.description');if(description){const p=out((local-.6)/.65);description.style.opacity=p;description.style.transform='translateY('+((1-p)*24)+'px)';}
 rows.forEach((row,i)=>{const p=out((local-.55-i*.24)/.8),focus=smooth((local-1-i*.62)/.35)*(1-smooth((local-1.65-i*.62)/.45));let x=(1-p)*45,y=(1-p)*28,ry=(1-p)*-16,rx=(1-p)*18;
   if(row.closest('.compare')){x=(1-p)*(i===0?-75:75);ry=(1-p)*(i===0?22:-22);}
   if(row.matches('.table-row')){x=0;y=(1-p)*12;ry=0;rx=0;row.style.clipPath='inset(0 '+((1-p)*100)+'% 0 0)';}
   row.style.opacity=p;row.style.transform='translate3d('+x+'px,'+y+'px,0) rotateY('+ry+'deg) rotateX('+rx+'deg)';row.style.setProperty('--focus',focus);row.style.setProperty('--trace',out((local-.8-i*.24)/.7));const path=row.querySelector('path');if(path)path.style.strokeDashoffset=42*(1-out((local-1-i*.24)/.55));
 });
 const contact=document.querySelector('.contact');if(contact){const p=out((local-.55)/.8);contact.style.clipPath='inset(0 '+((1-p)*100)+'% 0 0 round 12px)';contact.style.setProperty('--shine',(-130+260*smooth((local-1.2)/1.8))+'%');contact.querySelector('b').style.transform='translate('+Math.sin(time*1.6)*4+'px,'+(-Math.sin(time*1.6)*4)+'px)';}
 const connector=document.querySelector('.connector');if(connector)connector.style.transform='scaleY('+out((local-.7)/1.8)+')';
 document.querySelectorAll('.waves i').forEach((el,i)=>el.style.transform='scaleY('+(0.25+Math.abs(Math.sin(time*2.2+i*.8))*.75)+')');
 depth.forEach((el,i)=>{const drift=Math.sin(time*.35+i);el.style.transform='translate3d('+((1-settle)*(i-1)*55+drift*12)+'px,'+(Math.cos(time*.28+i)*15)+'px,'+(-50-i*70)+'px) rotateY('+(18+i*8+drift*7)+'deg) rotateZ('+(-14+i*13)+'deg)';});
 document.querySelector('.signature').style.transform='scaleX('+out((local-.3)/.8)+')';
 // Complete every wipe inside this scene: no late overlay across a following face clip.
 const entering=time<.58*tempo,leaving=time>duration-.36*tempo,curtain=document.querySelector('.curtain');curtain.style.visibility=entering||leaving?'visible':'hidden';
 panels.forEach((el,i)=>{const x=entering?125*out((time/tempo-i*.055)/.43):(-125+125*smooth(((time-duration)/tempo+.36-i*.025)/.25));el.style.transform='translateX('+x+'%) skewX(-9deg)';});
 return timeline;
}
const timeline={duration:()=>duration,totalDuration:()=>duration,time:t=>t===undefined?time:seek(t),totalTime:t=>t===undefined?time:seek(t),seek,pause:()=>{paused=true;return timeline},play:()=>{paused=false;return timeline},paused:()=>paused,timeScale:()=>1,getChildren:()=>[],eventCallback:()=>timeline};
window.__timelines={'socialpro-motion':timeline};window.renderFrame=seek;document.fonts.ready.then(()=>{fit();seek(time)});seek(0);
${preview ? `let origin;function tick(now){if(origin===undefined)origin=now;seek(((now-origin)/1000)%(duration+.7));requestAnimationFrame(tick)}if(!matchMedia('(prefers-reduced-motion: reduce)').matches)requestAnimationFrame(tick);else seek(duration/2);` : ''}
`;
}
