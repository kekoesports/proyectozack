import { and, desc, eq, inArray, isNull } from 'drizzle-orm';
import {
  studioProjects,
  studioReviews,
  talentUsers,
  studioInvitations,
} from '@/db/schema/studio';
import { talents } from '@/db/schema/talents';
import { user } from '@/db/schema/auth';
import type { StudioDatabase } from './repository';
import { campaigns } from '@/db/schema/campaigns';
import { STUDIO_DEAL_STATUSES, studioDealActivity, studioDealWindow } from './deal-activity';
import { studioCrmPhoto } from './crm-context';

/** Internal only: callers must requireStudioAgency before calling these functions. */
export async function studioAgencyWorkspaces(database: StudioDatabase, now = new Date()) {
  const window = studioDealWindow(now);
  // One row per deal; social networks/deliverables must never multiply its count.
  const deals = await database.select({ talentId: campaigns.talentId, status: campaigns.status, startDate: campaigns.startDate,
    endDate: campaigns.endDate, createdAt: campaigns.createdAt, archivedAt: campaigns.archivedAt })
    .from(campaigns).where(inArray(campaigns.status, [...STUDIO_DEAL_STATUSES]));
  const activity = new Map<number, { dealCount: number; activeDeals: number; lastActivity: string }>();
  for (const deal of deals) {
    const qualified = studioDealActivity(deal, window); if (!qualified) continue;
    const previous = activity.get(deal.talentId);
    activity.set(deal.talentId, { dealCount: (previous?.dealCount ?? 0) + 1,
      activeDeals: (previous?.activeDeals ?? 0) + Number(qualified.current),
      lastActivity: [previous?.lastActivity ?? '', qualified.lastActivity].sort().at(-1) ?? '' });
  }
  if (!activity.size) return [];
  const roster = await database.select({ id: talents.id, name: talents.name, photoUrl: talents.photoUrl, game: talents.game, status: talents.status })
    .from(talents).where(and(inArray(talents.id, [...activity.keys()]), isNull(talents.archivedAt)));
  return roster.flatMap(person => {
    const counts = activity.get(person.id);
    return counts ? [{ ...person, photoUrl: studioCrmPhoto(person.photoUrl), ...counts, since: window.since }] : [];
  }).sort((a, b) => b.dealCount - a.dealCount || b.activeDeals - a.activeDeals ||
    b.lastActivity.localeCompare(a.lastActivity) || a.name.localeCompare(b.name, 'es') || a.id - b.id);
}

export async function studioAgencyDashboard(database: StudioDatabase) {
  const [projects, roster, members] = await Promise.all([
    database
      .select({ project: studioProjects, name: talents.name })
      .from(studioProjects)
      .innerJoin(talents, eq(talents.id, studioProjects.talentId))
      .orderBy(desc(studioProjects.updatedAt))
      .limit(100),
    studioAgencyWorkspaces(database),
    database
      .select({
        id: talentUsers.id,
        talentId: talentUsers.talentId,
        active: talentUsers.active,
        name: talents.name,
      })
      .from(talentUsers)
      .innerJoin(talents, eq(talents.id, talentUsers.talentId)),
  ]);
  return { projects, roster, members };
}

export async function reviewStudioProject(
  database: StudioDatabase,
  input: {
    id: string;
    revision: number;
    decision: 'approved' | 'changes_requested';
    comment: string;
  },
  reviewer: string,
) {
  return database.transaction(async (tx) => {
    const [project] = await tx
      .update(studioProjects)
      .set({ status: input.decision, updatedAt: new Date() })
      .where(
        and(
          eq(studioProjects.id, input.id),
          eq(studioProjects.revision, input.revision),
          eq(studioProjects.status, 'in_review'),
        ),
      )
      .returning();
    if (!project) return false;
    await tx
      .insert(studioReviews)
      .values({
        projectId: project.id,
        revision: project.revision,
        decision: input.decision,
        comment: input.comment,
        reviewedBy: reviewer,
      });
    return true;
  });
}

export async function revokeStudioMember(database: StudioDatabase, id: string) {
  return database.transaction(async (tx) => {
    const [member] = await tx
      .update(talentUsers)
      .set({ active: false })
      .where(eq(talentUsers.id, id))
      .returning();
    if (!member) return false;
    const [account] = await tx
      .select({ email: user.email })
      .from(user)
      .where(eq(user.id, member.userId));
    // Revoke this account's invitations, not other representatives of the same talent.
    if (account)
      await tx
        .update(studioInvitations)
        .set({ revokedAt: new Date() })
        .where(
          and(
            eq(studioInvitations.talentId, member.talentId),
            eq(studioInvitations.email, account.email.toLowerCase()),
          ),
        );
    return true;
  });
}
