.sp-studio .demo-stage-rail{display:flex;justify-content:space-between;gap:8px;padding:16px 0 23px;margin-bottom:16px;border-bottom:1px solid #e8e0eb}
.sp-studio .demo-stage-rail>span{display:flex;align-items:center;gap:6px;font-size:10px;color:#776780}.sp-studio .demo-stage-rail b{display:grid;place-items:center;border:1px solid #dbc5d3;border-radius:50%;width:21px;height:21px;color:#a83c66}
.sp-studio .demo-upload-buttons,.sp-studio .demo-job-actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.sp-studio .demo-upload-buttons button{font-size:12px}.sp-studio .demo-transfer{margin:18px 0 8px}.sp-studio .demo-transfer span{display:block;font-size:11px;color:#70627a;margin-top:6px;font-variant-numeric:tabular-nums}
.sp-studio .demo-ingest progress{display:block;width:100%;height:7px;border:0;border-radius:10px;overflow:hidden;background:#eae2ed;accent-color:#c12e68}.sp-studio .demo-ingest progress::-webkit-progress-bar{background:#eae2ed}.sp-studio .demo-ingest progress::-webkit-progress-value{background:linear-gradient(90deg,#f5632a,#e03070,#8b3aad)}
.sp-studio .demo-jobs{border-top:1px solid #e6dfeb;padding-top:18px;margin-top:15px}.sp-studio .demo-jobs-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}.sp-studio .demo-jobs-head h3{font-size:14px;font-weight:700}.sp-studio .demo-jobs-head button{border:1px solid #e4d8e5;border-radius:9px;padding:9px;color:#986078;background:#faf8fb}
.sp-studio .demo-job{border:1px solid #e6dfea;border-radius:12px;padding:15px;margin:10px 0;display:grid;gap:10px}.sp-studio .demo-job[data-status=ready]{border-color:#b7d1bd;background:#f8fbf8}.sp-studio .demo-job[data-status=failed]{border-color:#e6bcc5;background:#fffafb}
.sp-studio .demo-job-title{display:flex;align-items:center;gap:10px}.sp-studio .demo-job-title>span{color:#a14870}.sp-studio .demo-job-title>div{min-width:0}.sp-studio .demo-job-title strong{font-size:12px;overflow-wrap:anywhere;display:block}.sp-studio .demo-job-title small{font-size:10px;color:#7a6d82;display:block;margin-top:5px}
.sp-studio .demo-job-actions button,.sp-studio .demo-resume button{font-size:10px;padding:6px 9px;border:1px solid #dccddd;background:white;border-radius:8px;color:#83506c}.sp-studio .demo-resume{font-size:11px;padding:13px;background:#f9f0f4;border-radius:10px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
