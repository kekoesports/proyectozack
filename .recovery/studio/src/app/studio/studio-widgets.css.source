.studio-brand-widgets{margin:22px 0;padding:22px;background:#f8f6f8;border:1px solid #e8e1e9;border-radius:14px}
.studio-brand-widgets header h3{font-size:22px;line-height:1.2;margin:8px 0;color:#211829}
.studio-brand-widgets p,.studio-brand-widgets small{font-size:11px;line-height:1.65;color:#6c6272}
.studio-widget-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:20px 0}
.studio-widget-grid fieldset{min-width:0;margin:0;padding:14px;border:1px solid #e1d9e6;border-radius:12px;background:#fff}
.studio-widget-grid legend{display:flex;gap:7px;align-items:center;padding:0 6px;font-size:12px;font-weight:700;color:#302337}
.studio-widget-grid label+label{margin-top:16px}
.studio-widget-grid audio{display:block;width:100%;height:34px;margin:14px 0 8px}
.studio-timeline-editor .studio-widget-check{display:flex;flex-direction:row;align-items:flex-start;gap:9px;line-height:1.6;margin-top:14px}
.studio-timeline-editor .studio-widget-check input{width:15px;height:15px;flex:none;margin:1px 0;accent-color:#c42880}
.studio-timeline-editor .studio-widget-position{max-width:310px}
.studio-widget-footnote{margin-bottom:0}.studio-widget-footnote a{color:#a9226d;text-decoration:underline}
.studio-widget-overlay{position:absolute;left:6%;right:6%;height:11.4cqw;pointer-events:none;display:flex;align-items:flex-start;justify-content:space-between;animation:studio-widget-enter .4s ease-out}
.studio-scene-preview{container-type:inline-size}
.studio-widget-overlay.top{top:10%}.studio-widget-overlay.bottom{bottom:24%}
.studio-widget-channel{width:58%;background:#15131eea;border-radius:2.2cqw;padding:2.3cqw 2cqw 2cqw 4.2cqw;position:relative;height:100%;box-sizing:border-box}
.studio-widget-channel:before{content:'';position:absolute;left:2.2cqw;top:2.5cqw;height:6.4cqw;width:.42cqw;background:#bf94ff}
.studio-widget-channel.kick:before{background:#53fc18}
.studio-widget-channel small{display:block;font:600 1.8cqw Inter,sans-serif;color:#bf94ff;line-height:1.2}
.studio-widget-channel.kick small{color:#53fc18}
.studio-widget-channel strong{display:block;font:700 3cqw Inter,sans-serif;color:white;line-height:1.8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.studio-widget-sponsor{width:32%;margin-left:auto;height:100%;display:flex;flex-direction:column;gap:1.2cqw}
.studio-widget-sponsor small{color:#fff;font-size:1.5cqw;text-shadow:0 1px 3px #000}
.studio-scene-preview .studio-widget-sponsor img{position:static;inset:auto;width:100%;height:70%;object-fit:contain;flex:1;min-height:0;background:transparent}
@keyframes studio-widget-enter{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:1050px){.studio-widget-grid{grid-template-columns:1fr}.studio-brand-widgets{padding:15px}}
@media(prefers-reduced-motion:reduce){.studio-widget-overlay{animation:none}}
