/** Browser journey against the loopback-only synthetic fixture. Never production credentials. */
import { chromium, expect } from '@playwright/test';
import { mkdir } from 'node:fs/promises';
import { randomBytes, randomUUID } from 'node:crypto';
import path from 'node:path';
const base = 'http://localhost:3107';
const output = path.resolve('.scratch/clip-lab-qa');
await mkdir(output, { recursive: true });
const browser = await chromium.launch({ headless: true });
const context = await browser.newContext({ viewport: { width: 1440, height: 1000 } });
await context.route('**/*', (route) => new URL(route.request().url()).origin === base ? route.continue() : route.abort());
const page = await context.newPage();
const errors = [];
page.on('pageerror', (error) => errors.push(error.name));
async function login(email) {
  await page.goto(`${base}/studio/login`);
  await expect(page.getByRole('button', { name: 'Entrar a Studio' })).toBeEnabled();
  await page.getByRole('textbox', { name: 'Correo de tu cuenta SocialPro' }).fill(email);
  await page.getByRole('textbox', { name: 'Contraseña', exact: true }).fill('Studio-fixture-only-2026!');
  const signIn = page.waitForResponse((response) => response.url() === `${base}/api/auth/sign-in/email` && response.request().method() === 'POST');
  await page.getByRole('button', { name: 'Entrar a Studio' }).click();
  expect((await signIn).status(), 'Fixture login; if rate-limited, wait for its window without disabling protection').toBe(200);
  await page.waitForURL(`${base}/studio`);
  await page.waitForLoadState('networkidle');
  const reject = page.getByRole('button', { name: 'Rechazar', exact: true });
  if (await reject.isVisible()) await reject.click();
}
try {
  await login('creator@studio.test');
  await page.goto(`${base}/studio/clips`);
  await page.waitForLoadState('networkidle');
  await expect(page.getByRole('heading', { level: 1 })).toContainText('No dejes');
  await page.getByLabel('Enlace de tu VOD').fill(`https://kick.com/videos/${randomUUID()}`);
  await page.getByLabel('Nombre de referencia').fill('Prueba sintética · directo Kick');
  await page.getByLabel('Duración en segundos').fill('600');
  await page.getByRole('checkbox', { name: 'Soy el titular o tengo autorización para utilizar este contenido.' }).check();
  await page.getByRole('button', { name: 'Añadir fuente', exact: true }).click();
  await page.waitForURL(/\/studio\/clips\?id=/);
  const kickUrl = page.url();
  await page.getByText('Marcar otro fragmento manualmente', { exact: true }).click();
  await page.getByLabel('Nombre del momento').fill('Prueba QA · decisión de equipo');
  await page.getByLabel('Inicio (segundos)').fill('120');
  await page.getByLabel('Final (segundos)').fill('145');
  await page.getByRole('button', { name: 'Guardar fragmento', exact: true }).click();
  await expect(page.locator('.clip-inspector h3')).toHaveText('Prueba QA · decisión de equipo');
  await page.getByRole('button', { name: 'Seleccionar', exact: true }).click();
  await expect(page.getByText('Selección guardada.', { exact: true })).toBeVisible();
  await page.evaluate(() => window.scrollTo({ top: 0, behavior: 'instant' }));
  await page.screenshot({ path: path.join(output, 'clip-lab-desktop.png'), fullPage: true });
  await page.goto(`${base}/studio/demos`);
  await page.waitForLoadState('networkidle');
  await expect(page.getByRole('heading', { level: 1 })).toContainText('Tu partida');
  const advanced = page.getByText('Importación avanzada: ya tengo el JSON de FragForge', { exact: true });
  if (await advanced.isVisible()) await advanced.click();
  const plan = { schema_version: '1.1', generated_at: '2026-09-06T12:00:00Z', demo: { path: 'DO-NOT-STORE-PRIVATE-PATH', sha256: randomBytes(32).toString('hex'), map: 'de_mirage', tickrate: 64, duration_ticks: 64000 },
    target: { steamid64: '76561198000000000', name_in_demo: 'Jugador sintético QA' },
    segments: [{ id: 'segment-1', round: 5, tick_start: 6400, tick_end: 8500, kills: [{ tick: 6900, weapon: 'ak47', headshot: true }, { tick: 7100, weapon: 'ak47', headshot: false }, { tick: 7300, weapon: 'ak47', headshot: true }] },
      { id: 'segment-2', round: 8, tick_start: 12800, tick_end: 14800, kills: [{ tick: 13500, weapon: 'awp', headshot: false }] }] };
  await page.getByLabel('Análisis JSON de FragForge').setInputFiles({ name: 'fixture-fragforge-plan.json', mimeType: 'application/json', buffer: Buffer.from(JSON.stringify(plan)) });
  await page.getByRole('checkbox', { name: 'Tengo permiso para usar esta partida y el material del jugador.' }).check();
  await page.getByRole('button', { name: 'Importar momentos' }).click();
  await page.waitForURL(/\/studio\/demos\?id=/);
  const sourceUrl = page.url();
  await expect(page.getByText('3 bajas registradas en el análisis', { exact: true })).toBeVisible();
  await expect(page.getByText('2 headshots', { exact: true })).toBeVisible();
  const markers = page.locator('.clip-time-rail button');
  await expect(markers).toHaveCount(2);
  await markers.nth(1).click();
  await expect(page.locator('.clip-inspector h3')).toHaveText('1 baja · ronda 8');
  await markers.first().click();
  await expect(page.locator('.clip-inspector h3')).toHaveText('3 bajas · ronda 5');
  await page.getByRole('button', { name: 'Seleccionar', exact: true }).click();
  await expect(page.getByText('Selección guardada.', { exact: true })).toBeVisible();
  await page.evaluate(() => window.scrollTo({ top: 0, behavior: 'instant' }));
  await page.screenshot({ path: path.join(output, 'demo-lab-desktop.png'), fullPage: true });
  await page.setViewportSize({ width: 390, height: 844 });
  await page.screenshot({ path: path.join(output, 'demo-lab-mobile.png'), fullPage: true });
  expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);
  await page.emulateMedia({ reducedMotion: 'reduce' });
  expect(await page.locator('.clip-orbit').evaluate((e) => getComputedStyle(e).animationName)).toBe('none');
  await page.goto(`${base}/studio/library`);
  await page.waitForLoadState('networkidle');
  await page.getByLabel('Añadir material propio').setInputFiles(path.resolve('public/motion/collection-03/gaming-clip.mp4'));
  await page.getByRole('checkbox', { name: 'Tengo permiso para usar este material en mi contenido.' }).check();
  await page.getByRole('button', { name: 'Guardar recurso', exact: true }).click();
  await expect(page.getByText('Recurso guardado en tu biblioteca privada.', { exact: true })).toBeVisible();
  await page.goto(sourceUrl);
  await page.waitForLoadState('networkidle');
  await page.getByLabel('Fragmento de tu biblioteca').selectOption({ label: 'gaming-clip.mp4' });
  await page.getByLabel('Segundos del archivo que usar (desde 0)').fill('20');
  await page.getByRole('checkbox', { name: 'He comprobado que el archivo corresponde a este momento.' }).check();
  await page.getByRole('button', { name: 'Preparar montaje', exact: true }).click();
  await page.waitForURL(/\/studio\/projects\//);
  await expect(page.getByText('3 bajas · ronda 5', { exact: true }).first()).toBeVisible();
  const projectUrl = page.url();
  await page.goto(sourceUrl);
  await expect(page.getByRole('link', { name: 'Abrir montaje', exact: true })).toHaveAttribute('href', new URL(projectUrl).pathname);
  await page.getByRole('button', { name: 'Salir', exact: true }).click();
  await login('other@studio.test');
  await page.goto(kickUrl);
  await expect(page.getByText('Prueba QA · decisión de equipo', { exact: true })).toHaveCount(0);
  await page.goto(sourceUrl);
  await expect(page.getByText('3 bajas registradas en el análisis', { exact: true })).toHaveCount(0);
  await page.goto(projectUrl);
  await expect(page.getByText('3 bajas · ronda 5', { exact: true })).toHaveCount(0);
  expect(errors).toEqual([]);
  console.log(`PASS: real fixture auth, manual Kick import/selection, CS2 JSON import, moment timeline, review persistence, private MP4 upload, editor handoff, cross-creator denial, mobile layout and reduced motion. No external network or render. Preview: ${sourceUrl}`);
} finally { await context.close(); await browser.close(); }
