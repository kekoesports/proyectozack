# Copiar a .env. Nunca versionar .env ni valores reales.
N8N_HOST=n8n.staging.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-32-random-characters
N8N_ENCRYPTION_KEY=replace-with-64-random-characters

SOCIALPRO_BASE_URL=https://socialpro-staging.example.com
SOCIALPRO_INTEGRATION_TOKEN=replace-with-the-same-staging-token-as-vercel
SOCIALPRO_AUTOMATION_OWNER_ID=replace-with-a-real-staging-user-id
AUTOMATION_WEBHOOK_SECRET=replace-with-the-same-hmac-secret-as-vercel

# Opcionales. Dejarlos vacíos mantiene los nodos proveedores sin capacidad de envío.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
OPENAI_API_KEY=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
